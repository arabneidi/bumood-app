generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                         String                      @id @default(cuid())
  name                       String?
  email                      String?                     @unique
  emailVerified              DateTime?
  image                      String?
  gender                     String?
  age                        Int?
  height                     Float?
  weight                     Float?
  timezone                   String?
  personality                String?
  universityLevel            String?
  fieldOfStudy               String?
  interests                  String?
  quoteStyle                 String?
  favoriteAuthors            String?
  favoriteWriters            String?
  favoriteSportsFigures      String?
  favoriteMusicians          String?
  favoriteArtists            String?
  favoriteMovies             String?
  favoritePhilosophers       String?
  customFavorites            String?
  recentActivities           String?
  darkMode                   Boolean  @default(false)
  aiActions                  AISuggestionAction[]
  accounts                   Account[]
  achievements               Achievement[]
  activityOutcomeConnections ActivityOutcomeConnection[]
  congratulations            Congratulation[]
  dailyTracking              DailyTracking[]
  goals                      Goal[]
  habits                     Habit[]
  moodEntries                MoodEntry[]
  periodTracking             PeriodTracking[]
  sessions                   Session[]
  proTips                    ProTip[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MoodEntry {
  id                    String   @id @default(cuid())
  userId                String
  valence               Int
  energy                Int
  focus                 Int
  stress                Int
  sleep                 Float?
  notes                 String?
  activities            String
  selectedTimeSlots     String?
  selectedSubcategories String?
  activityEntries       String?
  dssAnalysis           String?
  reflection            String?
  voiceNote             String?
  aiSuggestion          String?
  timeBucket            String   @default("morning")
  onPeriod              Boolean  @default(false)
  periodDay             Int?
  waterIntake           Int?
  mealsEaten            Int?
  mealQuality           String?
  caffeine              Int?
  alcohol               Int?
  moodComposite         Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Goal {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String?
  targetValue  Int?
  currentValue Int       @default(0)
  unit         String?
  category     String
  subcategory  String?
  difficulty   String    @default("medium")
  streak       Int       @default(0)
  bestStreak   Int       @default(0)
  completed    Boolean   @default(false)
  completedAt  DateTime?
  dssComponent String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Daily, per-goal progress increments to be used in DSS component calculations
model GoalProgressDaily {
  id        String   @id @default(cuid())
  userId    String
  goalId    String
  date      DateTime
  value     Int      @default(0) // increment/progress recorded for this day
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goalId, date])
  @@index([userId, date])
}

model PredefinedGoal {
  id           String   @id @default(cuid())
  title        String
  description  String?
  category     String
  subcategory  String
  dssComponent String
  targetValue  Int?
  unit         String?
  difficulty   String   @default("medium")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PredefinedActivity {
  id           String   @id @default(cuid())
  name         String
  icon         String
  category     String
  dssComponent String
  color        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Predefined achievements catalog (separate from per-user Achievement records)
model PredefinedAchievement {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String?
  stars       Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Achievement {
  id          String    @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  icon        String
  stars       Int       @default(1)
  unlockedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Habit {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String
  frequency   String     @default("daily")
  streak      Int        @default(0)
  bestStreak  Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  completed Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model AISuggestionAction {
  id           String    @id @default(cuid())
  userId       String
  suggestionId String
  title        String
  description  String
  action       String
  type         String
  priority     String
  category     String
  icon         String
  reasoning    String
  tried        Boolean   @default(false)
  helpful      Boolean?
  feedback     String?
  triedAt      DateTime?
  ratedAt      DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Congratulation {
  id            String   @id @default(cuid())
  userId        String
  type          String
  title         String
  message       String
  actionMessage String
  icon          String
  stars         Int      @default(1)
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PeriodTracking {
  id            String    @id @default(cuid())
  userId        String
  startDate     DateTime
  endDate       DateTime?
  flowIntensity String?
  symptoms      String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyTracking {
  id                        String   @id @default(cuid())
  userId                    String
  date                      DateTime @default(now())
  waterIntake               Int?
  mealsEaten                Int?
  mealQuality               String?
  caffeine                  Int?
  alcohol                   Int?
  exercise                  Boolean  @default(false)
  exerciseType              String?
  exerciseDuration          Int?
  steps                     Int?
  socialInteraction         Boolean  @default(false)
  screenTime                Int?
  outdoorTime               Int?
  meditation                Boolean  @default(false)
  meditationDuration        Int?
  journaling                Boolean  @default(false)
  readingTime               Int?
  medicationTaken           Boolean  @default(false)
  supplements               String?
  symptoms                  String?
  deepworkMinutes           Int?     @default(0)
  tasksCompleted            Int?     @default(0)
  sleepHours                Float?
  recoveryAction            Boolean  @default(false)
  positiveSocialTouchpoints Int?     @default(0)
  dssScore                  Float?
  moodComposite             Float?
  learningMomentum          Float?
  recoveryIndex             Float?
  connectionScore           Float?
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model ActivityOutcomeConnection {
  id            String   @id @default(cuid())
  userId        String
  activity      String
  outcome       String
  strength      Float    @default(1.0)
  positiveCount Int      @default(0)
  negativeCount Int      @default(0)
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activity, outcome])
}

model ProTip {
  id          String   @id @default(cuid())
  userId      String
  tip         String
  source      String   @default("ai") // "ai" or "system"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}
