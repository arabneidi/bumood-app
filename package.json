{
  "name": "bumood-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build:web": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter mobile typecheck",
    "lint": "pnpm --filter web lint"
  },
  "devDependencies": {
    "typescript": "^5.1.6"
  },
  "packageManager": "pnpm@8.15.0"
}

