// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Personal Information
  gender        String?   // male, female, non-binary, prefer-not-to-say
  age           Int?      // years
  height        Float?    // in cm
  weight        Float?    // in kg
  timezone      String?   // user's timezone
  personality   String?   // JSON array: ["INTJ", "ENFP", "ISTP"] (Myers-Briggs personality types)
  
  // University Information
  universityLevel String? // undergraduate, master, phd, other
  fieldOfStudy   String?  // Computer Science, Engineering, Medicine, etc.
  
  // Interests & Preferences (for AI personalization)
  interests     String?   // JSON array: gym, sports, poetry, art, music, science, etc.
  quoteStyle    String?   // motivational, poetic, scientific, spiritual, sporty
  favoriteAuthors String? // JSON array: favorite authors/figures for quotes
  
  // Activity-specific preferences (learned from user activities)
  favoriteWriters String? // JSON array: authors for book suggestions (learned from "reading" activity)
  favoriteSportsFigures String? // JSON array: athletes (learned from sports activities)
  favoriteMusicians String? // JSON array: musicians (learned from music activity)
  favoriteArtists String? // JSON array: artists (learned from art activity)
  favoriteMovies String? // JSON array: movies and TV shows (learned from watching activities)
  favoritePhilosophers String? // JSON array: philosophers (learned from philosophy interest)
  customFavorites String? // JSON array: custom favorite categories and items
  
  accounts      Account[]
  sessions      Session[]
  moodEntries   MoodEntry[]
  goals         Goal[]
  achievements  Achievement[]
  habits        Habit[]
  aiActions     AISuggestionAction[]
  periodTracking PeriodTracking[]
  dailyTracking DailyTracking[]
  activityOutcomeConnections ActivityOutcomeConnection[]
  congratulations Congratulation[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MoodEntry {
  id          String   @id @default(cuid())
  userId      String
  valence     Int      // 1-10 scale (overall mood/positivity)
  energy      Int      // 1-10 scale
  focus       Int      // 1-10 scale (concentration/attention)
  stress      Int      // 1-10 scale
  sleep       Float?   // hours of sleep
  notes       String?
  activities  String   // JSON string of activities
  selectedTimeSlots String? // JSON string of selected time slots (e.g., ["morning-7", "evening-19"])
  selectedSubcategories String? // JSON string of selected subcategories (e.g., ["K-Pop", "Hip Hop"])
  dssAnalysis String? // JSON string of DSS analysis for activities
  reflection  String?  // Micro-reflection
  voiceNote   String?  // AI-transcribed voice note
  aiSuggestion String? // AI-generated suggestion
  
  // Time-of-day bucket for Mood Composite calculation
  timeBucket  String   @default("morning") // "morning", "midday", "evening", "night"
  
  // Daily tracking
  onPeriod    Boolean  @default(false) // Is on period today
  periodDay   Int?     // Which day of period (1-7)
  waterIntake Int?     // glasses of water
  mealsEaten  Int?     // number of meals
  mealQuality String?  // poor, fair, good, excellent
  caffeine    Int?     // caffeinated drinks
  alcohol     Int?     // alcoholic drinks
  
  // Mood Composite (MC) score
  moodComposite Float? // MC = 0.4*zV + 0.3*zE + 0.2*zF - 0.2*zS
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  targetValue Int?
  currentValue Int     @default(0)
  unit        String?  // days, weeks, months, etc.
  category    String   // challenges, habits, health, sleep, growth, stress, relationships
  subcategory String?  // specific challenge type
  difficulty  String   @default("medium") // easy, medium, hard
  streak      Int      @default(0) // current streak
  bestStreak  Int      @default(0) // best streak achieved
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  type        String   // streak, goal, special
  title       String
  description String
  icon        String   // emoji or icon name
  stars       Int      @default(1) // 1-3 stars
  unlockedAt  DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Habit {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String   // health, productivity, wellness, etc.
  frequency   String   @default("daily") // daily, weekly, monthly
  streak      Int      @default(0)
  bestStreak  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  completed Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model AISuggestionAction {
  id          String   @id @default(cuid())
  userId      String
  suggestionId String  // Unique identifier for the suggestion
  title       String
  description String
  action      String
  type        String   // activity, tip, reminder, challenge, encouragement
  priority    String   // low, medium, high
  category    String
  icon        String
  reasoning   String
  tried       Boolean  @default(false)
  helpful     Boolean? // null = not rated, true = helpful, false = not helpful
  feedback    String?  // User's feedback on the suggestion
  triedAt     DateTime?
  ratedAt     DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Congratulation {
  id            String   @id @default(cuid())
  userId        String
  type          String   // goal_completed, achievement_unlocked, streak_milestone, progress_milestone
  title         String
  message       String
  actionMessage String
  icon          String
  stars         Int      @default(1)
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PeriodTracking {
  id          String   @id @default(cuid())
  userId      String
  startDate   DateTime // First day of period
  endDate     DateTime? // Last day of period (null if ongoing)
  flowIntensity String? // light, moderate, heavy
  symptoms    String?  // JSON string of symptoms (cramps, mood swings, etc.)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyTracking {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @default(now()) // Date of tracking (one entry per day)
  
  // Water & Hydration
  waterIntake Int?     // Number of glasses (250ml each) or total ml
  
  // Nutrition
  mealsEaten  Int?     // Number of meals (1-5)
  mealQuality String?  // poor, fair, good, excellent
  caffeine    Int?     // Number of caffeinated drinks
  alcohol     Int?     // Number of alcoholic drinks
  
  // Physical Activity
  exercise    Boolean  @default(false)
  exerciseType String? // cardio, strength, yoga, walking, etc.
  exerciseDuration Int? // minutes
  steps       Int?     // daily steps count
  
  // Social & Mental
  socialInteraction Boolean @default(false) // Had meaningful social interaction
  screenTime  Int?     // hours of screen time
  outdoorTime Int?     // minutes spent outdoors
  
  // Self-Care
  meditation  Boolean  @default(false)
  meditationDuration Int? // minutes
  journaling  Boolean  @default(false)
  readingTime Int?     // minutes spent reading
  
  // Health
  medicationTaken Boolean @default(false)
  supplements String?  // JSON string of supplements taken
  symptoms    String?  // JSON string of any physical symptoms
  
  // DSS Components - Daily Success Score
  // Learning Momentum (LM) = deepwork_minutes + 10*tasks_completed
  deepworkMinutes Int?     @default(0) // Minutes of deep work/focused work
  tasksCompleted  Int?     @default(0) // Number of tasks completed
  
  // Recovery Index (RI) = sleep_hours + (recovery_action ? 1 : 0)
  sleepHours       Float?  // Hours of sleep (already exists in MoodEntry, but tracking here too)
  recoveryAction   Boolean @default(false) // Did any recovery activity (meditation, rest, etc.)
  
  // Connection (CN) = positive_social_touchpoints
  positiveSocialTouchpoints Int? @default(0) // Number of positive social interactions
  
  // DSS Score (calculated)
  dssScore         Float?  // Daily Success Score (0.5*zLM + 0.3*zRI + 0.2*zCN)
  learningMomentum Float?  // LM component score
  recoveryIndex    Float?  // RI component score
  connectionScore  Float?  // CN component score
  
  // Notes
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date]) // Only one entry per user per day
}

model ActivityOutcomeConnection {
  id          String   @id @default(cuid())
  userId      String
  activity    String   // e.g., "reading", "music", "gym"
  outcome     String   // e.g., "sleep", "focus", "stress", "energy"
  strength    Float    @default(1.0) // 0.0 to 2.0, how strong the connection is
  positiveCount Int    @default(0) // Number of positive feedback instances
  negativeCount Int    @default(0) // Number of negative feedback instances
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, activity, outcome]) // One connection per user per activity-outcome pair
}
